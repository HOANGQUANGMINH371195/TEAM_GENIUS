# One-shot migration image. It is intentionally separate from the API image so
# production replicas never contain or receive the migration database role.
FROM python:3.11-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements/migrate.lock .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --require-hashes -r migrate.lock \
    && rm -rf /usr/local/bin/pip* /usr/local/bin/easy_install* \
        /usr/local/lib/python3.11/site-packages/pip* \
        /usr/local/lib/python3.11/site-packages/setuptools* \
        /usr/local/lib/python3.11/site-packages/wheel*

FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get dist-upgrade -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
        /usr/local/lib/python3.11/site-packages/pip* \
        /usr/local/lib/python3.11/site-packages/setuptools* \
        /usr/local/lib/python3.11/site-packages/wheel* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin appuser

ENV PYTHONPATH="/usr/local/lib/python3.11/site-packages" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --from=builder --chown=10001:10001 \
    /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --chown=10001:10001 database/postgres/migrations ./database/postgres/migrations

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/python3.11", "database/postgres/migrations/runner.py"]
