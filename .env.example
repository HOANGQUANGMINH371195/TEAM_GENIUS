# Copy to .env and fill every required secret.
# Never commit .env, database passwords, Aura passwords, or service accounts.

# ---- Application ----
APP_NAME=AI20K Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---- Supabase PostgreSQL ----
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
PGHOST=<pooler-host>
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.<project-ref>
PGPASSWORD=<database-password>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ---- OpenAI ----
OPENAI_API_KEY=<openai-api-key>
LLM_PROVIDER=openai
MODEL_NAME=<chat-model>
LLM_TEMPERATURE=0.7
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=256

# ---- Neo4j ----
# Local: bolt://localhost:7687
# Aura: neo4j+s://<aura-instance-id>.databases.neo4j.io
NEO4J_URI=neo4j+s://df378a84.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<neo4j-aura-password>
NEO4J_DATABASE=neo4j

# ---- Firebase Authentication ----
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<firebase-project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<firebase-project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<firebase-project>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<messaging-sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<firebase-app-id>

# ---- GraphRAG ----
RETRIEVAL_TOP_K=10
SEMANTIC_SIMILARITY_THRESHOLD=0.25
GRAPH_HOPS=1
GRAPH_NEIGHBOR_LIMIT=20
GRAPH_EVIDENCE_LIMIT=10
MAX_LLM_EVIDENCE=20
MAX_CITATIONS=8
MAX_CONTEXT_CHARS=60000
MAX_CHUNKS_PER_DOCUMENT=2
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Optional telemetry ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=false
