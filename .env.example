# Copy to .env and fill every required secret.
# Never commit .env, database passwords, Aura passwords, or service accounts.

# ---- Application ----
APP_NAME=AI20K Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Production must replace this with explicit HTTPS origins, for example:
# CORS_ORIGINS=https://<vercel-domain>
MAX_REQUEST_BODY_BYTES=131072
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Optional shared limiter for horizontally scaled Render services.
RATE_LIMIT_REDIS_URL=
CONVERSATION_CACHE_TTL_SECONDS=120
CONVERSATION_CACHE_MAX_TURNS=10
COST_QUOTA_UNITS=100000
COST_QUOTA_WINDOW_SECONDS=86400
METRICS_TOKEN=

# Dedicated service-role connection used only by the migration job.
MIGRATION_DATABASE_URL=
# Optional offline corpus worker connection; never use it from API request code.
PIPELINE_DATABASE_URL=

# ---- Supabase PostgreSQL ----
# Preferred read/runtime connection. DATABASE_URL below remains a compatibility alias.
RUNTIME_DATABASE_URL=
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
PGHOST=<pooler-host>
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.<project-ref>
PGPASSWORD=<database-password>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_POOL_RECYCLE=1800

# ---- OpenAI ----
OPENAI_API_KEY=<openai-api-key>
LLM_PROVIDER=openai
MODEL_NAME=gpt-5.6-luna
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=900
LLM_REASONING_EFFORT=none
LLM_VERBOSITY=low
LLM_USE_RESPONSES_API=true
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_TOKENS=180
QUERY_REWRITE_TIMEOUT_SECONDS=10
# Typed model router for task assignment; deterministic policy remains fallback.
MODEL_ROUTER_ENABLED=true
MODEL_ROUTER_MODEL_NAME=gpt-5.4-nano
MODEL_ROUTER_TIMEOUT_SECONDS=4.0
MODEL_ROUTER_MAX_TOKENS=160
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=256

# ---- Neo4j ----
# Local: bolt://localhost:7687
# Aura: neo4j+s://<aura-instance-id>.databases.neo4j.io
NEO4J_URI=neo4j+s://<aura-instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<neo4j-aura-password>
NEO4J_DATABASE=neo4j

# ---- Qdrant Cloud (external vector store) ----
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=<qdrant-api-key>
# Must equal the active release projection locator from PostgreSQL.
QDRANT_COLLECTION=<active-projection-collection>
QDRANT_TIMEOUT_SECONDS=30
RETRIEVAL_TIMEOUT_SECONDS=45
PROVIDER_CONCURRENCY=8
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30

# ---- AI Log / agent telemetry ----
# Required when the team agent-log collector is enabled.
AI_LOG_SERVER=https://<ai-log-server>
AI_LOG_API_KEY=<ai-log-api-key>
AI_LOG_DIR=.ai-log

# ---- Corpus enrichment (optional for runtime; required by Tavily scripts) ----
TAVILY_API_KEY=<tavily-api-key>

# Legacy local vector cache; production semantic vectors use Qdrant.
CHROMA_PERSIST_DIR=.chroma

# ---- Firebase client configuration ----
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<firebase-project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<firebase-project>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<firebase-project>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<firebase-messaging-sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<firebase-app-id>

# ---- Firebase Admin (backend) ----
# Load the real single-line service-account JSON from an ignored .env or secret manager.
# Never commit a service-account private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- GraphRAG ----
RETRIEVAL_TOP_K=10
SEMANTIC_SIMILARITY_THRESHOLD=0.25
GRAPH_HOPS=1
GRAPH_NEIGHBOR_LIMIT=20
GRAPH_EVIDENCE_LIMIT=10
MAX_LLM_EVIDENCE=12
MAX_CITATIONS=12
MAX_CONTEXT_CHARS=100000
MAX_CONTEXT_TOKENS=32000
MAX_CHUNKS_PER_DOCUMENT=4
RERANKER_BACKEND=heuristic
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_CANDIDATES=30
COMMUNITY_INDEX_PATH=
GLOBAL_MAX_COMMUNITIES=3
GLOBAL_MAX_ROUNDS=2
EXPERIENCE_INDEX_PATH=
FEATURE_EXPERIENCE_RETRIEVAL_ENABLED=false
RESEARCH_QUEUE_BACKEND=memory
RESEARCH_QUEUE_REDIS_URL=
RESEARCH_QUEUE_MAX_PENDING=32
RESEARCH_QUEUE_MAX_WORKERS=2
RESEARCH_QUEUE_TIMEOUT_SECONDS=90
RESEARCH_QUEUE_TTL_SECONDS=900
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Feature flags (safe canary/rollback switches) ----
FEATURE_PLANNER_ENABLED=true
FEATURE_RERANKER_ENABLED=true
FEATURE_AUDITOR_ENABLED=true
FEATURE_CALCULATOR_ENABLED=true
FEATURE_VIEWER_ENABLED=true
FEATURE_TIMELINE_ENABLED=true
FEATURE_ELIGIBILITY_ENABLED=true
FEATURE_GRAPH_ENABLED=true
FEATURE_GLOBAL_SEARCH_ENABLED=false

# ---- Optional telemetry (Langfuse Cloud US) ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGCHAIN_TRACING_V2=false
PROMPT_REGISTRY_NAME=medipay-system
PROMPT_REGISTRY_LABEL=production
PROMPT_REGISTRY_CACHE_TTL_SECONDS=300
LANGFUSE_TIMEOUT_SECONDS=2

# ---- Optional OpenTelemetry OTLP/HTTP ----
# Leave endpoint empty to disable local export. Production may point this at
# Langfuse OTLP or an OpenTelemetry Collector; never put private prompt/evidence
# in headers or attributes.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=medipay-api
OTEL_SAMPLING_RATIO=0.1
OTEL_MAX_QUEUE_SIZE=2048
OTEL_MAX_EXPORT_BATCH_SIZE=256
OTEL_SCHEDULE_DELAY_MILLIS=5000
OTEL_EXPORT_TIMEOUT_SECONDS=5

# ---- Deployment identifiers (non-secret; credentials stay in ignored .env) ----
# Vercel project name/ID is required by `make deploy-vercel` unless web/ is
# linked locally. A stored CLI login is enough; VERCEL_TOKEN is optional.
DEPLOY_VERCEL_ORG_ID=
DEPLOY_VERCEL_PROJECT_ID=
# VERCEL_TOKEN=
